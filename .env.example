# Copy to .env for Docker Compose; local Python reads exported environment variables.
NETEASE_HOST=0.0.0.0
NETEASE_PORT=5023
NETEASE_DEFAULT_QUALITY=lossless
NETEASE_REQUEST_TIMEOUT=30
NETEASE_DOWNLOAD_TIMEOUT=600
NETEASE_MAX_CONCURRENT=3
NETEASE_MAX_FILE_SIZE=524288000
# NETEASE_API_URL=http://127.0.0.1:5023
